# Database
# Для локальной разработки используйте PostgreSQL
# Для продакшена рекомендуется Neon, Supabase или другой облачный PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/familypay?schema=public"

# NextAuth.js
# NEXTAUTH_URL должен соответствовать вашему домену
# Для локальной разработки: http://localhost:3000
# Для продакшена: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# NEXTAUTH_SECRET - секретный ключ для шифрования сессий
# Сгенерируйте с помощью команды: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl"

# OAuth Providers (опционально)
# Google OAuth - получите на https://console.cloud.google.com/
# 1. Создайте проект
# 2. Включите Google+ API
# 3. Создайте OAuth 2.0 Client ID
# 4. Добавьте Authorized redirect URIs
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (опционально, для уведомлений)
# Для Gmail создайте App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
MAIL_FROM=""

# Telegram Bot для 2FA (опционально)
# Создайте бота у @BotFather в Telegram
# Получите Chat ID через специальный скрипт или бот
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- AI-помощник (Groq) ---
# Получите БЕСПЛАТНЫЙ API ключ на https://console.groq.com/
# Groq предоставляет быстрый доступ к llama-3.3-70b модели
GROQ_API_KEY=""

# --- Finik Pay Configuration (опционально) ---
# Платежная система для Кыргызстана
# Окружение: "beta" для тестирования, "prod" для продакшена
FINIK_ENV="beta"
# API ключ (получите в личном кабинете Finik)
FINIK_API_KEY=""
# ID вашего аккаунта в Finik
FINIK_ACCOUNT_ID=""
# Приватный ключ (ТОЛЬКО для продакшена, для beta не требуется)
# FINIK_PRIVATE_KEY=""
